{
  "duration": {
    "fast": {
      "$value": "150ms",
      "$type": "duration"
    },
    "normal": {
      "$value": "300ms",
      "$type": "duration"
    },
    "slow": {
      "$value": "600ms",
      "$type": "duration"
    }
  },
  "easing": {
    "default": {
      "$value": "{easing.inOut}",
      "$type": "cubicBezier"
    },
    "linear": {
      "$value": [0, 0, 1, 1],
      "$type": "cubicBezier"
    },
    "in": {
      "$value": [0.42, 0, 1, 1],
      "$type": "cubicBezier"
    },
    "out": {
      "$value": [0, 0, 0.58, 1],
      "$type": "cubicBezier"
    },
    "inOut": {
      "$value": [0.42, 0, 0.58, 1],
      "$type": "cubicBezier"
    },
    "outCirc": {
      "$value": [0, 0.55, 0.45, 1],
      "$type": "cubicBezier"
    },
    "outExpo": {
      "$value": [0.16, 1, 0.3, 1],
      "$type": "cubicBezier"
    },
    "outBack": {
      "$value": [0.34, 1.56, 0.64, 1],
      "$type": "cubicBezier"
    },
    "bounce": {
      "$value": [0.165, 0.84, 0.44, 1],
      "$type": "cubicBezier"
    }
  },
  "transition": {
    "fast": {
      "$value": "all {duration.fast} {easing.default}",
      "$type": "string"
    },
    "normal": {
      "$value": "all {duration.normal} {easing.default}",
      "$type": "string"
    },
    "slow": {
      "$value": "all {duration.slow} {easing.default}",
      "$type": "string"
    },
    "boxShadow": {
      "$value": "box-shadow {duration.normal} {easing.default}",
      "$type": "string"
    },
    "color": {
      "$value": "color {duration.normal} {easing.default}, background-color {duration.normal} {easing.default}, border-color {duration.normal} {easing.default}, outline-color {duration.normal} {easing.default}, fill {duration.normal} {easing.default}, stroke {duration.normal} {easing.default}, text-decoration {duration.normal} {easing.default}",
      "$type": "string"
    },
    "opacity": {
      "$value": "opacity {duration.normal} {easing.default}",
      "$type": "string"
    },
    "transform": {
      "$value": "transform {duration.normal} {easing.default}",
      "$type": "string"
    },
    "property": {
      "color": {
        "$value": "color, background-color, border-color, outline-color, fill, stroke, text-decoration",
        "$type": "string"
      }
    }
  }
}
