{
  "form": {
    "border": {
      "radius": {
        "$value": "{radius.xs}",
        "$type": "dimension"
      },
      "width": {
        "$value": "{border.width.sm}",
        "$type": "dimension"
      }
    },
    "color": {
      "accent": {
        "$value": "{color.black}",
        "$type": "color"
      },
      "background": {
        "$value": "{color.white}",
        "$type": "color",
        "$mods": { "dark": "{color.gray.900}" }
      },
      "border": {
        "default": {
          "$value": "{color.border.default}",
          "$type": "color"
        },
        "hover": {
          "$value": "{color.border.hover}",
          "$type": "color"
        }
      },
      "text": {
        "$value": "{color.text.default}",
        "$type": "color"
      }
    },
    "padding": {
      "$value": "{spacing.control}",
      "$type": "dimension"
    },
    "shadow": {
      "default": {
        "$value": "{shadow.control.default}",
        "$type": "shadow"
      },
      "hover": {
        "$value": "{shadow.control.hover}",
        "$type": "shadow"
      }
    },
    "transition": {
      "$value": "{transition.normal}",
      "$type": "string"
    }
  },

  "input": {
    "border": {
      "radius": {
        "$value": "{form.border.radius}",
        "$type": "dimension"
      },
      "width": {
        "$value": "{form.border.width}",
        "$type": "dimension"
      }
    },

    "color": {
      "background": {
        "$value": "{form.color.background}",
        "$type": "color"
      },

      "border": {
        "default": {
          "$value": "{form.color.border.default}",
          "$type": "color"
        },
        "hover": {
          "$value": "{form.color.border.hover}",
          "$type": "color"
        }
      },

      "placeholder": {
        "$value": "{color.text.muted}",
        "$type": "color"
      },

      "text": {
        "$value": "{form.color.text}",
        "$type": "color"
      }
    },

    "padding": {
      "$value": "{form.padding}",
      "$type": "dimension"
    }
  },

  "file": {
    "button": {
      "marginEnd": {
        "$value": "{size.12}",
        "$type": "dimension"
      },

      "padding": {
        "$value": "{size.8} {size.12}",
        "$type": "string"
      }
    }
  },

  "textarea": {
    "border": {
      "radius": {
        "$value": "{form.border.radius}",
        "$type": "dimension"
      },

      "width": {
        "$value": "{form.border.width}",
        "$type": "dimension"
      }
    },

    "color": {
      "background": {
        "$value": "{form.color.background}",
        "$type": "color"
      },

      "border": {
        "default": {
          "$value": "{form.color.border.default}",
          "$type": "color"
        },
        "hover": {
          "$value": "{form.color.border.hover}",
          "$type": "color"
        }
      },

      "placeholder": {
        "$value": "{color.text.muted}",
        "$type": "color"
      },

      "text": {
        "$value": "{form.color.text}",
        "$type": "color"
      }
    },

    "minHeight": {
      "$value": "5lh",
      "$type": "dimension"
    },

    "padding": {
      "$value": "{form.padding}",
      "$type": "dimension"
    }
  },

  "select": {
    "border": {
      "radius": {
        "$value": "{form.border.radius}",
        "$type": "dimension"
      },

      "width": {
        "$value": "{form.border.width}",
        "$type": "dimension"
      }
    },

    "color": {
      "background": {
        "$value": "{form.color.background}",
        "$type": "color"
      },

      "border": {
        "default": {
          "$value": "{form.color.border.default}",
          "$type": "color"
        },
        "hover": {
          "$value": "{form.color.border.hover}",
          "$type": "color"
        }
      },

      "optgroup": {
        "$value": "{color.text.muted}",
        "$type": "color"
      },

      "text": {
        "$value": "{form.color.text}",
        "$type": "color"
      }
    },

    "icon": {
      "$value": "{icon.chevron}",
      "$type": "string"
    },

    "iconSize": {
      "$value": "{icon.size}",
      "$type": "dimension"
    },

    "padding": {
      "$value": "{form.padding}",
      "$type": "dimension"
    },

    "paddingEnd": {
      "$value": "2rem",
      "$type": "dimension"
    }
  },

  "label": {
    "color": {
      "text": {
        "$value": "{form.color.text}",
        "$type": "color"
      }
    },

    "fontSize": {
      "$value": "{fontSize.xs}",
      "$type": "dimension"
    },

    "fontWeight": {
      "$value": "{fontWeight.medium}",
      "$type": "fontWeight"
    },

    "padding": {
      "x": {
        "$value": "0",
        "$type": "dimension"
      },
      "y": {
        "$value": "{spacing.2xs}",
        "$type": "dimension"
      }
    },

    "textTransform": {
      "$value": "uppercase",
      "$type": "string"
    }
  },

  "help": {
    "color": {
      "text": {
        "$value": "{color.text.muted}",
        "$type": "color"
      }
    },

    "fontSize": {
      "$value": "{fontSize.xs}",
      "$type": "dimension"
    },

    "fontWeight": {
      "$value": "{fontWeight.normal}",
      "$type": "fontWeight"
    },

    "margin": {
      "$value": "0",
      "$type": "dimension"
    }
  },

  "checkable": {
    "color": {
      "$value": "{form.color.accent}",
      "$type": "color"
    },

    "size": {
      "$value": "1.25em",
      "$type": "dimension"
    }
  },

  "checkbox": {
    "border": {
      "radius": {
        "$value": "0",
        "$type": "dimension"
      },

      "width": {
        "$value": "{form.border.width}",
        "$type": "dimension"
      }
    },

    "color": {
      "background": {
        "default": {
          "$value": "{form.color.background}",
          "$type": "color"
        },
        "checked": {
          "$value": "{form.color.background}",
          "$type": "color"
        },
        "hover": {
          "$value": "{form.color.background}",
          "$type": "color"
        }
      },

      "border": {
        "default": {
          "$value": "{form.color.border.default}",
          "$type": "color"
        },
        "checked": {
          "$value": "{checkable.color}",
          "$type": "color"
        },
        "hover": {
          "$value": "{form.color.border.hover}",
          "$type": "color"
        }
      }
    },

    "label": {
      "padding": {
        "$value": "0 0 0 .3125rem",
        "$type": "string"
      }
    },

    "mask": {
      "checked": {
        "$value": "{icon.tick} center no-repeat",
        "$type": "string"
      },

      "indeterminate": {
        "$value": "{icon.dash} center no-repeat",
        "$type": "string"
      }
    },

    "scale": {
      "checked": {
        "$value": "0.7",
        "$type": "number"
      }
    }
  },

  "radio": {
    "border": {
      "radius": {
        "$value": "{radius.pill}",
        "$type": "dimension"
      },

      "width": {
        "$value": "{form.border.width}",
        "$type": "dimension"
      },

      "widthChecked": {
        "$value": "{border.width.md}",
        "$type": "dimension"
      }
    },

    "color": {
      "background": {
        "default": {
          "$value": "{form.color.background}",
          "$type": "color"
        },
        "checked": {
          "$value": "{checkable.color}",
          "$type": "color"
        },
        "hover": {
          "$value": "{form.color.background}",
          "$type": "color"
        }
      },

      "border": {
        "default": {
          "$value": "{form.color.border.default}",
          "$type": "color"
        },
        "checked": {
          "$value": "{checkable.color}",
          "$type": "color"
        },
        "hover": {
          "$value": "{form.color.border.hover}",
          "$type": "color"
        }
      },
    },

    "label": {
      "padding": {
        "$value": "0 0 0 .3125rem",
        "$type": "string"
      }
    },

    "scale": {
      "checked": {
        "$value": "0.5",
        "$type": "number"
      }
    }
  },

  "range": {
    "thumb": {
      "border": {
        "width": {
          "$value": "{size.4}",
          "$type": "dimension"
        },

        "color": {
          "$value": "{color.white}",
          "$type": "color"
        }
      },

      "color": {
        "$value": "{form.color.accent}",
        "$type": "color"
      },

      "size": {
        "$value": "{size.24}",
        "$type": "dimension"
      }
    },

    "track": {
      "color": {
        "$value": "{form.color.border.default}",
        "$type": "color"
      },

      "height": {
        "$value": "calc({border.width.sm} + 2px)",
        "$type": "string"
      }
    }
  },

  "switch": {
    "border": {
      "radius": {
        "$value": "{radius.pill}",
        "$type": "dimension"
      },

      "width": {
        "$value": "{form.border.width}",
        "$type": "dimension"
      }
    },

    "color": {
      "background": {
        "default": {
          "$value": "{form.color.background}",
          "$type": "color"
        },
        "checked": {
          "$value": "{form.color.background}",
          "$type": "color"
        },
        "hover": {
          "$value": "{form.color.background}",
          "$type": "color"
        }
      },
      "border": {
        "$value": "{form.color.border.default}",
        "$type": "color"
      }
    },

    "thumb": {
      "color": {
        "default": {
          "$value": "{form.color.accent}",
          "$type": "color"
        },
        "checked": {
          "$value": "{form.color.background}",
          "$type": "color"
        }
      },

      "scale": {
        "$value": "0.6",
        "$type": "number"
      }
    },

    "track": {
      "color": {
        "default": {
          "$value": "{form.color.background}",
          "$type": "color"
        },
        "checked": {
          "$value": "{form.color.accent}",
          "$type": "color"
        }
      }
    },

    "width": {
      "$value": "{size.40}",
      "$type": "dimension"
    }
  }
}