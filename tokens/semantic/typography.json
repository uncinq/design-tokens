{
  "fontFamily": {
    "code": {
      "$type": "fontFamily",
      "$value": "{fontFamily.mono}"
    },
    "heading": {
      "$type": "fontFamily",
      "$value": "{fontFamily.sans}"
    },
    "text": {
      "$type": "fontFamily",
      "$value": "{fontFamily.sans}"
    }
  },
  "fontSize": {
    "2xs": {
      "$type": "dimension",
      "$value": "{size.12}"
    },
    "xs": {
      "$type": "dimension",
      "$value": "{size.14}"
    },
    "sm": {
      "$type": "dimension",
      "$value": "{size.16}"
    },
    "md": {
      "$type": "dimension",
      "$value": "{size.18}"
    },
    "lg": {
      "$type": "dimension",
      "$value": "{size.24}"
    },
    "xl": {
      "$type": "dimension",
      "$value": "{size.48}"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "{size.64}"
    },
    "display": {
      "$type": "dimension",
      "$value": "{size.96}"
    },
    "fluid": {
      "2xs": {
        "$type": "dimension",
        "$value": "clamp(0.625rem, 0.5893rem + 0.1786vw, 0.75rem)"
      },
      "xs": {
        "$type": "dimension",
        "$value": "clamp(0.75rem, 0.7143rem + 0.1786vw, 0.875rem)"
      },
      "sm": {
        "$type": "dimension",
        "$value": "clamp(0.875rem, 0.8393rem + 0.1786vw, 1rem)"
      },
      "md": {
        "$type": "dimension",
        "$value": "clamp(1rem, 0.9643rem + 0.1786vw, 1.125rem)"
      },
      "lg": {
        "$type": "dimension",
        "$value": "clamp(1.125rem, 1.0179rem + 0.5357vw, 1.5rem)"
      },
      "xl": {
        "$type": "dimension",
        "$value": "clamp(1.5rem, 1.0714rem + 2.1429vw, 3rem)"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "clamp(3rem, 2.7143rem + 1.4286vw, 4rem)"
      },
      "display": {
        "$type": "dimension",
        "$value": "clamp(4rem, 3.4286rem + 2.8571vw, 6rem)"
      }
    },
    "heading": {
      "01": {
        "$type": "dimension",
        "$value": "{fontSize.fluid.xl}"
      },
      "02": {
        "$type": "dimension",
        "$value": "{fontSize.fluid.lg}"
      },
      "03": {
        "$type": "dimension",
        "$value": "{fontSize.fluid.md}"
      },
      "04": {
        "$type": "dimension",
        "$value": "{fontSize.fluid.sm}"
      },
      "05": {
        "$type": "dimension",
        "$value": "{fontSize.fluid.sm}"
      },
      "06": {
        "$type": "dimension",
        "$value": "{fontSize.fluid.sm}"
      }
    },
    "small": {
      "$type": "dimension",
      "$value": "{fontSize.fluid.sm}"
    },
    "text": {
      "$type": "dimension",
      "$value": "{fontSize.fluid.md}"
    }
  },
  "fontWeight": {
    "control": {
      "$type": "fontWeight",
      "$value": "{fontWeight.medium}"
    },
    "heading": {
      "$type": "fontWeight",
      "$value": "{fontWeight.bold}"
    },
    "text": {
      "$type": "fontWeight",
      "$value": "{fontWeight.normal}"
    }
  },
  "letterSpacing": {
    "none": {
      "$type": "dimension",
      "$value": "0em"
    },
    "sm": {
      "$type": "dimension",
      "$value": "0.025em"
    },
    "md": {
      "$type": "dimension",
      "$value": "0.05em"
    },
    "lg": {
      "$type": "dimension",
      "$value": "0.1em"
    },
    "xl": {
      "$type": "dimension",
      "$value": "0.2em"
    }
  },
  "lineHeight": {
    "heading": {
      "$type": "number",
      "$value": "{lineHeight.tight}"
    },
    "text": {
      "$type": "number",
      "$value": "{lineHeight.normal}"
    }
  },
  "maxWidth": {
    "heading": {
      "$type": "dimension",
      "$value": "50ch"
    },
    "paragraph": {
      "$type": "dimension",
      "$value": "70ch"
    }
  }
}
