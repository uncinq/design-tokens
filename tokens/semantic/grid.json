{
  "columns": {
    "mobile": {
      "$value": "1",
      "$type": "number"
    },
    "tablet": {
      "$value": "12",
      "$type": "number"
    },
    "tabletWide": {
      "$value": "12",
      "$type": "number"
    },
    "laptop": {
      "$value": "12",
      "$type": "number"
    },
    "desktop": {
      "$value": "12",
      "$type": "number"
    }
  },
  "gap": {
    "default": {
      "$value": "{spacing.md}",
      "$type": "dimension"
    },
    "column": {
      "$value": "{spacing.md}",
      "$type": "dimension"
    },
    "row": {
      "$value": "{spacing.fluid.sm}",
      "$type": "dimension"
    }
  },
  "span": {
    "full": {
      "$value": "1 / -1",
      "$type": "string"
    },
    "half": {
      "$value": "span calc(var(--columns) / 2)",
      "$type": "string"
    },
    "quarter": {
      "$value": "span calc(var(--columns) / 4)",
      "$type": "string"
    },
    "third": {
      "$value": "span calc(var(--columns) / 3)",
      "$type": "string"
    }
  }
}
