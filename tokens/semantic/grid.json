{
  "columns": {
    "$value": "12",
    "$type": "number"
  },
  "gap": {
    "default": {
      "$value": "{spacing.md}",
      "$type": "dimension"
    },
    "column": {
      "$value": "{spacing.md}",
      "$type": "dimension"
    },
    "row": {
      "$value": "{spacing.fluid.sm}",
      "$type": "dimension"
    }
  },
  "span": {
    "full": {
      "$value": "1 / -1",
      "$type": "string"
    },
    "half": {
      "$value": "span calc({columns} / 2)",
      "$type": "string"
    },
    "quarter": {
      "$value": "span calc({columns} / 4)",
      "$type": "string"
    },
    "third": {
      "$value": "span calc({columns} / 3)",
      "$type": "string"
    }
  }
}
