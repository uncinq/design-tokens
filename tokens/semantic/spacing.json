{
  "spacing": {
    "2xs": {
      "$value": "{size.5}",
      "$type": "dimension"
    },
    "xs": {
      "$value": "{size.10}",
      "$type": "dimension"
    },
    "sm": {
      "$value": "{size.20}",
      "$type": "dimension"
    },
    "md": {
      "$value": "{size.30}",
      "$type": "dimension"
    },
    "lg": {
      "$value": "{size.40}",
      "$type": "dimension"
    },
    "xl": {
      "$value": "{size.60}",
      "$type": "dimension"
    },
    "2xl": {
      "$value": "{size.100}",
      "$type": "dimension"
    },
    "3xl": {
      "$value": "{size.150}",
      "$type": "dimension"
    },
    "fluid": {
      "2xs": {
        "$value": "clamp(0.3125rem, 0.2232rem + 0.4464vw, 0.625rem)",
        "$type": "dimension"
      },
      "xs": {
        "$value": "clamp(0.625rem, 0.4464rem + 0.8929vw, 1.25rem)",
        "$type": "dimension"
      },
      "sm": {
        "$value": "clamp(1.25rem, 0.8929rem + 1.7857vw, 2.5rem)",
        "$type": "dimension"
      },
      "md": {
        "$value": "clamp(1.875rem, 1.3393rem + 2.6786vw, 3.75rem)",
        "$type": "dimension"
      },
      "lg": {
        "$value": "clamp(2.5rem, 1.7857rem + 3.5714vw, 5rem)",
        "$type": "dimension"
      },
      "xl": {
        "$value": "clamp(3.125rem, 2.2321rem + 4.4643vw, 6.25rem)",
        "$type": "dimension"
      },
      "2xl": {
        "$value": "clamp(3.75rem, 2.6786rem + 5.3571vw, 7.5rem)",
        "$type": "dimension"
      }
    },
    "card": {
      "$value": "{spacing.sm}",
      "$type": "dimension"
    },
    "control": {
      "$value": "{spacing.xs}",
      "$type": "dimension"
    },
    "heading": {
      "$value": "{spacing.fluid.sm}",
      "$type": "dimension"
    },
    "section": {
      "$value": "{spacing.fluid.2xl}",
      "$type": "dimension"
    },
    "surface": {
      "$value": "{spacing.fluid.sm}",
      "$type": "dimension"
    },
    "typography": {
      "$value": "{spacing.fluid.xs}",
      "$type": "dimension"
    }
  }
}
