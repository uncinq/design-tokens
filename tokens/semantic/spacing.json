{
  "spacing": {
    "2xs": {
      "$value": "{size.5}",
      "$type": "dimension"
    },
    "xs": {
      "$value": "{size.10}",
      "$type": "dimension"
    },
    "sm": {
      "$value": "{size.20}",
      "$type": "dimension"
    },
    "md": {
      "$value": "{size.30}",
      "$type": "dimension"
    },
    "lg": {
      "$value": "{size.40}",
      "$type": "dimension"
    },
    "xl": {
      "$value": "{size.60}",
      "$type": "dimension"
    },
    "2xl": {
      "$value": "{size.100}",
      "$type": "dimension"
    },
    "3xl": {
      "$value": "{size.150}",
      "$type": "dimension"
    },
    "fluid": {
      "2xs": {
        "$value": "clamp(0.3125rem, 0.2025rem + 0.4695vw, 0.625rem)",
        "$type": "dimension"
      },
      "xs": {
        "$value": "clamp(0.625rem, 0.4049rem + 0.9390vw, 1.25rem)",
        "$type": "dimension"
      },
      "sm": {
        "$value": "clamp(1.25rem, 0.8099rem + 1.8779vw, 2.5rem)",
        "$type": "dimension"
      },
      "md": {
        "$value": "clamp(1.875rem, 1.2148rem + 2.8169vw, 3.75rem)",
        "$type": "dimension"
      },
      "lg": {
        "$value": "clamp(2.5rem, 1.6197rem + 3.7559vw, 5rem)",
        "$type": "dimension"
      },
      "xl": {
        "$value": "clamp(3.125rem, 2.0246rem + 4.6948vw, 6.25rem)",
        "$type": "dimension"
      },
      "2xl": {
        "$value": "clamp(3.75rem, 2.4296rem + 5.6338vw, 7.5rem)",
        "$type": "dimension"
      }
    },
    "card": {
      "$value": "{spacing.sm}",
      "$type": "dimension"
    },
    "control": {
      "$value": "{spacing.xs}",
      "$type": "dimension"
    },
    "heading": {
      "$value": "{spacing.fluid.sm}",
      "$type": "dimension"
    },
    "section": {
      "$value": "{spacing.fluid.2xl}",
      "$type": "dimension"
    },
    "surface": {
      "$value": "{spacing.fluid.sm}",
      "$type": "dimension"
    },
    "typography": {
      "$value": "{spacing.fluid.xs}",
      "$type": "dimension"
    }
  }
}
