{
  "shadow": {
    "none": {
      "$type": "shadow",
      "$value": {
        "color": "transparent",
        "offsetX": "0",
        "offsetY": "0",
        "blur": "0",
        "spread": "0",
        "inset": false
      }
    },
    "sm": {
      "$type": "shadow",
      "$value": [
        {
          "color": "{color.shadow.normal}",
          "offsetX": "0",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0",
          "inset": false
        },
        {
          "color": "{color.shadow.normal}",
          "offsetX": "0",
          "offsetY": "1px",
          "blur": "1px",
          "spread": "-1px",
          "inset": false
        }
      ]
    },
    "md": {
      "$type": "shadow",
      "$value": [
        {
          "color": "{color.shadow.normal}",
          "offsetX": "0",
          "offsetY": "4px",
          "blur": "6px",
          "spread": "-1px",
          "inset": false
        },
        {
          "color": "{color.shadow.normal}",
          "offsetX": "0",
          "offsetY": "2px",
          "blur": "4px",
          "spread": "-2px",
          "inset": false
        }
      ]
    },
    "lg": {
      "$type": "shadow",
      "$value": [
        {
          "color": "{color.shadow.normal}",
          "offsetX": "0",
          "offsetY": "10px",
          "blur": "15px",
          "spread": "-3px",
          "inset": false
        },
        {
          "color": "{color.shadow.normal}",
          "offsetX": "0",
          "offsetY": "4px",
          "blur": "6px",
          "spread": "-4px",
          "inset": false
        }
      ]
    },

    "center": {
      "sm": {
        "$type": "shadow",
        "$value": {
          "color": "{color.shadow.normal}",
          "offsetX": "0",
          "offsetY": "0",
          "blur": "2px",
          "spread": "2px",
          "inset": false
        }
      },
      "md": {
        "$type": "shadow",
        "$value": {
          "color": "{color.shadow.normal}",
          "offsetX": "0",
          "offsetY": "0",
          "blur": "4px",
          "spread": "4px",
          "inset": false
        }
      },
      "lg": {
        "$type": "shadow",
        "$value": {
          "color": "{color.shadow.normal}",
          "offsetX": "0",
          "offsetY": "0",
          "blur": "8px",
          "spread": "8px",
          "inset": false
        }
      }
    }
  }
}