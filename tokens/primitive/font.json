{
  "fontFamily": {
    "mono": {
      "$type": "fontFamily",
      "$value": "ui-monospace, monospace"
    },
    "sans": {
      "$type": "fontFamily",
      "$value": "system-ui, sans-serif"
    },
    "serif": {
      "$type": "fontFamily",
      "$value": "Georgia, serif"
    }
  },

  "fontWeight": {
    "thin": {
      "$type": "fontWeight",
      "$value": 100
    },
    "extraLight": {
      "$type": "fontWeight",
      "$value": 200
    },
    "light": {
      "$type": "fontWeight",
      "$value": 300
    },
    "normal": {
      "$type": "fontWeight",
      "$value": 400
    },
    "medium": {
      "$type": "fontWeight",
      "$value": 500
    },
    "semibold": {
      "$type": "fontWeight",
      "$value": 600
    },
    "bold": {
      "$type": "fontWeight",
      "$value": 700
    },
    "extraBold": {
      "$type": "fontWeight",
      "$value": 800
    },
    "black": {
      "$type": "fontWeight",
      "$value": 900
    }
  },

  "lineHeight": {
    "none": {
      "$type": "number",
      "$value": 1
    },
    "tight": {
      "$type": "number",
      "$value": 1.1
    },
    "snug": {
      "$type": "number",
      "$value": 1.25
    },
    "normal": {
      "$type": "number",
      "$value": 1.5
    },
    "relaxed": {
      "$type": "number",
      "$value": 1.75
    },
    "loose": {
      "$type": "number",
      "$value": 2
    }
  },

  "textDecoration": {
    "offset": {
      "$type": "dimension",
      "$value": "0.25rem"
    },
    "thickness": {
      "$type": "dimension",
      "$value": "1px"
    }
  }
}